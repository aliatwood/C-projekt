@* Övre delen av navigeringsmenyn med applikationens namn *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FlashQuiz</a>
    </div>
</div>

@* Knapp som används för att öppna och stänga navigeringsmenyn på mindre skärmar *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* Navigeringsmeny med länkar till applikationens olika sidor *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @* Navigeringslänk till startsidan *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* Navigeringslänk till quizfunktionen *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Quiz">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Quiz
            </NavLink>
        </div>

        @* Navigeringslänk till sidan som visar poäng och resultat *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Scores">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Scores
            </NavLink>
        </div>
    </nav>
</div>

