    // Kontrollerar om spelarens svar är rätt och uppdaterar poängen.
    private void CheckAnswer(string selectedOption)
    {
        if (selectedOption == filteredQuestions[currentQuestionIndex].CorrectAnswer)
        {
            score++;
        }

        currentQuestionIndex++;
    }

    // Återställer quizet så att spelaren kan börja om från början.
    private void RestartQuiz()
    {
        currentQuestionIndex = 0;
        score = 0;
        selectedDifficulty = "";
    }

    private string playerName = "";

    // Sparar spelarens resyltat och navigerar vidare till poängsidan.
    private void SaveAndNavigate()
    {
