@page "/quiz"

@* Används för att navigera mellan applikationens sidor *@
@inject NavigationManager Navigation

@* Används för att spara spelarens poäng *@
@inject ScoreService ScoreService
@using System.Linq

<PageTitle>Quiz</PageTitle>

@* Huvudcontainer för quizet *@
<div class="quiz-container">

    @* Länk för att lämna quizet och återgå till startsidan *@
    <NavLink href="" class="leave-quiz-btn">← Leave Page</NavLink>
    @if (string.IsNullOrEmpty(selectedDifficulty))
    {
        @* Visar svårighetsvalet innan quizet startar *@
        <div class="difficulty-selection">
            <h2 class="difficulty-title">Choose Your Speed</h2>
            <button @onclick='() => SelectDifficulty("easy")' class="diff-btn">Easy</button>
            <button @onclick='() => SelectDifficulty("intermediate")' class="diff-btn">Intermediate</button>
            <button @onclick='() => SelectDifficulty("advanced")' class="diff-btn">Advanced</button>
        </div>
    }

    @* Visar aktuell fråga och svarsalternativ under quizets gång *@
    else @if (currentQuestionIndex < filteredQuestions.Count)
    {
        <p>Question @(currentQuestionIndex + 1)/@filteredQuestions.Count <span>Score: @score</span></p>

        <h2>@filteredQuestions[currentQuestionIndex].QuestionText</h2>

        @foreach (var option in filteredQuestions[currentQuestionIndex].Options)
        {
            <button @onclick="() => CheckAnswer(option)">@option</button>
        }
    }

    @* Visar slutresultatet när alla frågor har svarats *@
    else
    {
        <div class="game-over">
            <p class="game-over-text">You scored @score out of @filteredQuestions.Count points!</p>

            @* Inmatning av spelarens namn och möjlighet att spara resultatet *@
            <div class="save-section">
                <input type="text" @bind="playerName" placeholder="Enter your name..."  class="name-input">
                <button @onclick="SaveAndNavigate" class="save-btn">Save Score ⚡</button>
            </div>

            <button @onclick="RestartQuiz" class="restart-btn">Play Again</button>
        </div>
    }
</div>



<style>
